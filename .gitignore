# Data — fetched by `make data`, never committed (see docs/DATA_CARD.md § 9)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Results — run artifacts are local; registry.csv IS committed
results/runs/*
!results/runs/.gitkeep
results/figures/*.png
!results/figures/.gitkeep
models/
*.onnx
*.bin
*.safetensors

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Notebooks
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env
