# Data — fetched by `make data`, never committed (see docs/DATA_CARD.md § 9)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
# External evaluation corpora (ViLexNorm, NEU-ESC): research licences, never redistributed here.
data/external/*
!data/external/README.md
!data/processed/.gitkeep

# Results — run artifacts are local; registry.csv IS committed
# Per-run artifacts. preds.csv is large and regenerable from a checkpoint, so it stays out;
# metrics.json and config.yaml are small and ARE tracked, because a result nobody else can inspect
# is not a result. Review R11 warned that only .gitkeep was tracked here; a `git add -A` over a
# missing directory then deleted every local artifact in one commit, which is exactly the failure
# that warning described.
results/runs/*
!results/runs/.gitkeep
!results/runs/*/
results/runs/*/preds.csv
# Validation predictions carry no text (only test predictions do), and example-level paired
# comparisons need them (review § 8.1). Test predictions stay local: they contain corpus text.
!results/runs/*-val/preds.csv
results/runs/*/confusion.png
!results/runs/*/metrics.json
!results/runs/*/config.yaml
!results/runs/*/env.json
results/figures/*.png
# Study outputs that contain corpus text stay local (docs/DATA_CARD.md § 11)
results/studies/**/local/
!results/figures/.gitkeep
# Anchored with a leading slash. Without it, git matches the pattern at ANY depth, and
# `models/` silently excluded the src/vifeedback/models/ PACKAGE from every commit.
/models/
*.onnx
*.bin
*.safetensors

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
/dist/
/build/

# Notebooks
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env

# Upload archives built by `git archive` for Kaggle/Colab
*.zip

# Kaggle output staging: extract here, then `vifeedback results merge` (never over results/)
/kaggle_results/
/results_new/
